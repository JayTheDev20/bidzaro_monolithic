# ==================================
# APPLICATION CONFIGURATION
# ==================================
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Platform Settings - USA focused
DEFAULT_COUNTRY=USA
DEFAULT_CURRENCY=USD
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ==================================
# RATE LIMIT / OTP
# ==================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=100
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ==================================
# BIDDING CONFIGURATION
# ==================================
BIDDING_COMPETITIVE_HOURS=72
BIDDING_COOLING_HOURS=24
BIDDING_PAYMENT_COOLING_HOURS=2
BIDDING_EXPIRY_HOURS=168
BIDDING_MIN_VENDORS=3
BIDDING_MAX_REVISIONS=5

# ==================================
# PAYMENT CONFIGURATION
# ==================================
PAYMENT_TOKEN_PERCENT=25
PAYMENT_PLATFORM_FEE_PERCENT=2
PAYMENT_GATEWAY_FEE_PERCENT=2
PAYMENT_AUTO_REFUND=true
PAYMENT_TIMEOUT_HOURS=24

# ==================================
# CANCELLATION POLICY
# ==================================
CANCELLATION_WINDOW_DAYS=30

CANCEL_TIER_1_DAYS=30
CANCEL_TIER_1_REFUND=100
CANCEL_TIER_2_DAYS=15
CANCEL_TIER_2_REFUND=75
CANCEL_TIER_3_DAYS=7
CANCEL_TIER_3_REFUND=50
CANCEL_TIER_4_DAYS=3
CANCEL_TIER_4_REFUND=25
CANCEL_TIER_5_DAYS=0
CANCEL_TIER_5_REFUND=0

# ==================================
# LOYALTY & REFERRAL
# ==================================
LOYALTY_POINTS_PER_RUPEE=1
LOYALTY_RUPEES_PER_POINT=0.25
LOYALTY_MAX_REDEEM_PERCENT=50
LOYALTY_EXPIRY_DAYS=365
LOYALTY_SIGNUP_BONUS=100

REFERRAL_REFERRER_POINTS=500
REFERRAL_REFERRED_POINTS=200
REFERRAL_ENABLED=true

# ==================================
# FILE UPLOAD CONFIGURATION
# ==================================
UPLOAD_PATH=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOC_MB=10
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB

# ==================================
# LOGGING
# ==================================
LOG_ROOT_LEVEL=INFO
LOG_APP_LEVEL=DEBUG
LOG_SECURITY_LEVEL=INFO
LOG_MONGO_LEVEL=INFO

# ==================================
# ACTUATOR / MONITORING
# ==================================
ACTUATOR_EXPOSE_ENDPOINTS=health,info,metrics,prometheus

# ==================================
# SWAGGER / API DOCS
# ==================================
SWAGGER_API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_ENABLED=true
SWAGGER_OP_SORTER=method
SWAGGER_TAG_SORTER=alpha

# ==================================
# ENVIRONMENT
# ==================================
SPRING_PROFILES_ACTIVE=dev
